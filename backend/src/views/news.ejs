<%- include('partials/header') %>

<div class="flex items-center justify-between">
  <div>
    <h2 class="text-2xl font-bold text-slate-800">News Articles</h2>
    <p class="text-sm text-slate-500 mt-1">Manage latest news and announcements.</p>
  </div>
  <button onclick="openModal()" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium shadow-sm shadow-brand-500/30 transition-colors">
    <i data-lucide="plus" class="w-4 h-4"></i>
    Add Article
  </button>
</div>

<!-- Table Section -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider font-semibold">
          <th class="px-6 py-4">Title & Image</th>
          <th class="px-6 py-4">Category</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm">
        <% if (news && news.length > 0) { %>
          <% news.forEach(function(item) { %>
            <tr class="hover:bg-slate-50/50 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-10 rounded-lg bg-slate-100 overflow-hidden shrink-0 border border-slate-200">
                    <img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover">
                  </div>
                  <div>
                    <p class="font-bold text-slate-800 line-clamp-1"><%= item.title %></p>
                    <p class="text-xs text-slate-500 mt-0.5 line-clamp-1"><%= item.description %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-600 font-medium">
                <%= item.category %>
              </td>
              <td class="px-6 py-4">
                <% if (item.isPublished) { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Published
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-xs font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Draft
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                  <button onclick="openEditModal(this)" data-id="<%= item._id %>" data-item="<%= encodeURIComponent(JSON.stringify(item)) %>" class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-brand-50 rounded-md transition-colors" title="Edit">
                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                  </button>
                  <button onclick="deleteItem('<%= item._id %>')" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors" title="Delete">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="px-6 py-12 text-center text-slate-500">
              <div class="flex flex-col items-center justify-center">
                <i data-lucide="inbox" class="w-10 h-10 text-slate-300 mb-3"></i>
                <p>No news articles found.</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Overlay -->
<div id="itemModal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" onclick="closeModal()"></div>
  <div class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col transform transition-transform translate-x-full duration-300" id="modalPanel">
    
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <h3 class="text-lg font-bold text-slate-800" id="modalTitle">Add News Article</h3>
      <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6">
      <form id="itemForm" class="space-y-4">
        <input type="hidden" id="itemId" name="_id">
        
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title</label>
          <input type="text" name="title" id="itemTitle" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all sm:text-sm">
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Category</label>
          <input type="text" name="category" id="itemCategory" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all sm:text-sm">
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Upload Image</label>
          <input type="file" name="image" id="itemImage" accept="image/*" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all sm:text-sm">
          <p class="text-xs text-slate-500 mt-1">Leave empty to keep existing image when editing.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
          <textarea name="description" id="itemDesc" rows="4" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all sm:text-sm"></textarea>
        </div>
      </form>
    </div>

    <div class="p-6 border-t border-slate-100 bg-slate-50">
      <button type="button" onclick="submitForm()" id="submitBtn" class="w-full bg-brand-600 hover:bg-brand-700 text-white py-2.5 rounded-lg font-medium shadow-sm shadow-brand-500/30 transition-colors flex items-center justify-center gap-2">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>Save Article</span>
      </button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('itemModal');
  const panel = document.getElementById('modalPanel');
  const form = document.getElementById('itemForm');
  let currentMode = 'create';

  function openEditModal(btn) {
    const id = btn.getAttribute('data-id');
    try {
      const itemStr = decodeURIComponent(btn.getAttribute('data-item'));
      const itemData = JSON.parse(itemStr);
      openModal(id, itemData);
    } catch (e) {
      console.error("Failed to parse item data:", e);
      showToast("Error opening data", "error");
    }
  }

  function openModal(id = null, data = null) {
    modal.classList.remove('hidden');
    setTimeout(() => { panel.classList.remove('translate-x-full'); }, 10);
    
    if (id && data) {
      currentMode = 'edit';
      document.getElementById('modalTitle').innerText = 'Edit Article';
      document.getElementById('itemId').value = id;
      document.getElementById('itemTitle').value = data.title || '';
      document.getElementById('itemCategory').value = data.category || '';
      document.getElementById('itemImage').value = ''; // Cannot set value for file input
      document.getElementById('itemDesc').value = data.description || '';
    } else {
      currentMode = 'create';
      document.getElementById('modalTitle').innerText = 'Add News Article';
      form.reset();
      document.getElementById('itemId').value = '';
    }
  }

  function closeModal() {
    panel.classList.add('translate-x-full');
    setTimeout(() => { modal.classList.add('hidden'); }, 300);
  }

  async function submitForm() {
    if(!form.checkValidity()) { form.reportValidity(); return; }

    const btn = document.getElementById('submitBtn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div><span>Saving...</span>';

    const formData = new FormData(form);
    const id = formData.get('_id');
    formData.delete('_id');

    if (currentMode === 'edit' && formData.get('image') && formData.get('image').size === 0) {
      formData.delete('image');
    }

    const url = currentMode === 'edit' ? `/api/v1/news/${id}` : '/api/v1/news';
    const method = currentMode === 'edit' ? 'PUT' : 'POST';

    try {
      const response = await fetch(url, {
        method, body: formData
      });
      const result = await response.json();
      
      if(result.success) {
        showToast(`Article ${currentMode === 'edit' ? 'updated' : 'created'} successfully!`, 'success');
        closeModal(); setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(result.error || 'Failed to save', 'error');
        btn.disabled = false; btn.innerHTML = originalText;
      }
    } catch(err) {
      showToast('A network error occurred.', 'error');
      btn.disabled = false; btn.innerHTML = originalText;
    }
  }

  async function deleteItem(id) {
    if(confirm('Are you sure you want to delete this?')) {
      try {
        const response = await fetch(`/api/v1/news/${id}`, { method: 'DELETE' });
        const result = await response.json();
        if(result.success) {
          showToast('Deleted successfully.', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else showToast('Failed to delete.', 'error');
      } catch(err) { showToast('A network error occurred.', 'error'); }
    }
  }
</script>

<%- include('partials/footer') %>
